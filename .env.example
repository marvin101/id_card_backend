DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

SECRET_KEY=replace_with_a_long_random_secret
# Recommended: a separate random secret for signed public credentials.
CREDENTIAL_SIGNING_KEY=replace_with_a_different_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace_with_the_private_server_side_key

CORS_ORIGINS=http://localhost:49567,http://127.0.0.1:49567

# Public login/registration throttling (per application process).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
REGISTRATION_RATE_LIMIT_REQUESTS=5
PUBLIC_FORM_GET_RATE_LIMIT_REQUESTS=60
PUBLIC_FORM_SUBMIT_RATE_LIMIT_REQUESTS=10
PUBLIC_DESIGN_GET_RATE_LIMIT_REQUESTS=60
PUBLIC_VERIFICATION_GET_RATE_LIMIT_REQUESTS=120
PUBLIC_FORM_MAX_REQUEST_BYTES=7340032

# Public Flutter origin used to build the revocable URL encoded into ID-card QR codes.
PUBLIC_APP_URL=https://idcard-flutter-web.vercel.app

# Render normally contributes one trusted proxy hop. Use 0 if the API is
# directly exposed; never trust more hops than are actually controlled.
AUTH_RATE_LIMIT_TRUSTED_PROXY_HOPS=1
