DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSLMODE=require

SECRET_KEY=replace_with_a_long_random_secret
# Recommended: a separate random secret for signed public credentials.
CREDENTIAL_SIGNING_KEY=replace_with_a_different_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace_with_the_private_server_side_key

CORS_ORIGINS=http://localhost:49567,http://127.0.0.1:49567

# Public login/registration throttling (per application process).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
REFRESH_RATE_LIMIT_REQUESTS=60
REGISTRATION_RATE_LIMIT_REQUESTS=5
PUBLIC_FORM_GET_RATE_LIMIT_REQUESTS=60
PUBLIC_FORM_SUBMIT_RATE_LIMIT_REQUESTS=10
PUBLIC_DESIGN_GET_RATE_LIMIT_REQUESTS=60
PUBLIC_VERIFICATION_GET_RATE_LIMIT_REQUESTS=120
PUBLIC_FORM_MAX_REQUEST_BYTES=7340032

# Email verification throttling (per application process).
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=900
EMAIL_VERIFICATION_ISSUE_RATE_LIMIT_REQUESTS=3
EMAIL_VERIFICATION_VERIFY_RATE_LIMIT_REQUESTS=20

# Password reset throttling (per application process).
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_REQUEST_RATE_LIMIT_REQUESTS=3
PASSWORD_RESET_CONFIRM_RATE_LIMIT_REQUESTS=10

# Public Flutter origin used to build revocable student-verification QR URLs.
PUBLIC_APP_URL=https://campusid.co.in

# Render normally contributes one trusted proxy hop. Use 0 if the API is
# directly exposed; never trust more hops than are actually controlled.
AUTH_RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# Absolute workday session lifetime; access tokens renew silently within it.
REFRESH_TOKEN_EXPIRE_MINUTES=720

# Trusted-device MFA bypass lifetime (days; 1–365).
TRUSTED_DEVICE_TTL_DAYS=30

# MFA encryption key. Configure a dedicated strong key if MFA secret encryption
# is enabled by this deployment; never reuse the outbox or JWT signing key.
MFA_ENCRYPTION_KEY=replace_with_a_dedicated_mfa_encryption_key

# ==========================================================
# SMTP Email Delivery (Brevo)
# ==========================================================

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=replace_with_your_smtp_key

SMTP_FROM_EMAIL=noreply@campusid.co.in
SMTP_FROM_NAME=CampusID

# Keep enabled in production so SMTP authentication and message delivery
# occur over TLS.
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# ==========================================================
# Transactional Email Outbox
# ==========================================================

# Generate a Fernet key locally:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# IMPORTANT:
# - Use a newly generated key; do not reuse SECRET_KEY, CREDENTIAL_SIGNING_KEY,
#   MFA_ENCRYPTION_KEY, or SMTP credentials.
# - Configure the exact same key on the FastAPI Render Web Service and the
#   Render Background Worker.
# - Keep it private and backed up securely. Existing encrypted outbox jobs
#   cannot be decrypted after losing or changing this key without a key-rotation
#   procedure.
EMAIL_OUTBOX_ENCRYPTION_KEY=replace_with_a_private_fernet_key

EMAIL_OUTBOX_POLL_SECONDS=3
EMAIL_OUTBOX_LEASE_SECONDS=120
EMAIL_OUTBOX_MAX_ATTEMPTS=8
